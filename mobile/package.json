{
  "name": "@pecklist/mobile",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "description": "Android shell around the PeckList web app (Capacitor)",
  "scripts": {
    "build:web": "pnpm --filter @pecklist/web build",
    "sync": "cap sync android",
    "apk": "pnpm build:web && cap sync android && node scripts/gradle.mjs assembleDebug",
    "test:android": "node scripts/gradle.mjs testDebugUnitTest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "6.0.3"
  }
}
