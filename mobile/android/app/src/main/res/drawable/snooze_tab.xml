<?xml version="1.0" encoding="utf-8"?>
<!-- A snooze picker tab: a ripple, and a line under the chosen one (snooze_dialog.xml). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item android:gravity="bottom" android:height="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/notification_accent" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item android:gravity="bottom" android:height="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?android:attr/colorControlHighlight" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
