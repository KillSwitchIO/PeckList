<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted servers on a home network often run on plain http (http://192.168.1.20:8080), so the
  app allows it; the connect screen warns, and the app keeps the yes for that server only (audit A2).
  Certificates the person installed themselves are trusted too, for servers behind a home CA
  (Caddy's internal one, step-ca), but only for a server the person agreed to: the app checks when
  connecting, at each check-in and at each start (InstalledCa). This file is fixed when the app is
  built, so those checks are native.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
