<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">PeckList</string>
    <string name="title_activity_main">PeckList</string>
    <string name="package_name">com.pecklist.app</string>
    <string name="custom_url_scheme">com.pecklist.app</string>
    <!-- The page shown when the server cannot be reached on a start with nothing cached (ShellWebViewClient). -->
    <string name="offline_title">"Can't reach your server"</string>
    <string name="offline_body">PeckList could not reach %1$s. Check your connection, or whether the server is running.</string>
    <string name="offline_retry">Try again</string>
    <string name="offline_other">Use another server</string>

    <!-- Asked in the app's own dialog when a server's page moves the app (audit A4). -->
    <string name="confirm_connect_title">Switch servers?</string>
    <string name="confirm_connect_body">PeckList will use %1$s from now on.</string>
    <string name="confirm_connect_plain">It uses plain http, so anyone on the network can read what is sent.</string>
    <string name="confirm_connect_installed_ca">Its certificate comes from an authority installed on this phone, which PeckList will trust for it.</string>
    <string name="confirm_connect_yes">Switch</string>
    <string name="confirm_disconnect_title">Use PeckList without a server?</string>
    <string name="confirm_disconnect_body">PeckList stops using %1$s. Your tasks stay on the server.</string>
    <string name="confirm_disconnect_yes">Disconnect</string>

    <!-- The chosen server is now vouched for by an authority installed on the phone (audit A2). -->
    <string name="installed_ca_title">Check this server\'s certificate</string>
    <string name="installed_ca_body">%1$s now uses a certificate from an authority installed on this phone, not one Android trusts by default. Someone may be reading what PeckList sends. Trust it only if you installed that authority for this server.</string>
    <string name="installed_ca_trust">Trust it</string>
    <!-- A sign-in page in front of the server (Pangolin, Cloudflare Access...; Gate). -->
    <string name="gate_title">Sign in to reach your server</string>
    <string name="gate_body">%1$s asks you to sign in before PeckList opens. Sign in in your browser, then come back here.</string>
    <string name="gate_sign_in">Sign in</string>
    <string name="gate_here">Sign in here instead</string>
    <string name="gate_link_hint">Behind Pangolin? Paste a share link for this server instead:</string>
    <string name="gate_link_use">Use the link</string>
    <!-- Notification channels, as Settings > Apps > PeckList > Notifications lists them (PL-115). -->
    <string name="channel_reminders">Reminders</string>
    <string name="channel_assignments">Assignments and dibs</string>
    <string name="channel_shares">Shared lists</string>
    <string name="channel_comments">Comments and mentions</string>
    <!-- A reminder's buttons and text (Reminders, ReminderReceiver); the web app words them the same. -->
    <string name="action_complete">Complete</string>
    <string name="action_snooze">Snooze</string>
    <!-- The snooze picker (SnoozeActivity), like TickTick's. -->
    <string name="snooze_title">Snooze until</string>
    <string name="snooze_minutes">%1$d minutes</string>
    <string name="snooze_hour">1 hour</string>
    <string name="snooze_hours">%1$d hours</string>
    <string name="snooze_tomorrow">Tomorrow at %1$s</string>
    <string name="snooze_custom">Pick a time</string>
    <string name="snooze_done">Snoozed until %1$s</string>
    <string name="reminder_body">Reminder for %1$s</string>
    <!-- Back with nothing left to go back to (MainActivity). -->
    <string name="back_again">Press Back again to leave PeckList</string>
    <!-- The launcher icon's long-press shortcut: back to the connect page, whatever the server runs. -->
    <string name="shortcut_server_short">Change server</string>
    <string name="shortcut_server_long">Change server or use without one</string>
</resources>
