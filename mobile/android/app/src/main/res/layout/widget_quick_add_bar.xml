<?xml version="1.0" encoding="utf-8"?>
<!-- The 4x1 quick add widget (QuickAddBarWidget): looks like the app's add field. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_quick_add"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_pill"
        android:contentDescription="@string/widget_add"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_accent"
            tools:ignore="UseAppTint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/widget_add"
            android:textColor="@color/widget_muted"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
