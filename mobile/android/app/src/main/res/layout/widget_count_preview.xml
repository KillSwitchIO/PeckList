<?xml version="1.0" encoding="utf-8"?>
<!-- The count widget in the picker (Android 12 and later): a sample number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_count_sample"
        android:textColor="@color/widget_on_surface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_count_today"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
