# PeckList settings that are read from the environment only. The service (pecklist.service) and
# the maintenance command (pecklist-server) both read this file, so they always open the same
# database. One NAME=value per line, no quotes. Everything else goes in pecklist.conf.
# After a change: sudo systemctl restart pecklist

# The port the server listens on, on all addresses.
ASPNETCORE_HTTP_PORTS=8080
DB_PATH=/var/lib/pecklist/pecklist.db
CONFIG_FILE=/etc/pecklist/pecklist.conf
# Logs go to the journal; the JSON log files stay off unless you want both.
LOG_FILES=false
