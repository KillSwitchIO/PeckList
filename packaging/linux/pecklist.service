# systemd unit of the PeckList server package (deb and rpm). Settings that only come from the
# environment (the port, the database path) are in /etc/pecklist/pecklist.env; everything else is in
# /etc/pecklist/pecklist.conf. After changing either: sudo systemctl restart pecklist
#   journalctl -u pecklist          # the first admin password is printed here, once
# The archive download has its own unit: examples/linux/pecklist.service.

[Unit]
Description=PeckList tasks and calendar
Documentation=https://docs.pecklist.com/
After=network-online.target
Wants=network-online.target

[Service]
# The server tells systemd when it is ready (and when it stops).
Type=notify
User=pecklist
Group=pecklist
WorkingDirectory=/var/lib/pecklist
EnvironmentFile=/etc/pecklist/pecklist.env
ExecStart=/usr/lib/pecklist/pecklist
Restart=on-failure
RestartSec=5
# Exits that a restart cannot fix: bad settings (2), a newer database (3), an unwritable folder (4).
RestartPreventExitStatus=2 3 4

# Hardening: the server only writes its own data folder, needs no capabilities and no port below
# 1024. Not set: MemoryDenyWriteExecute (.NET compiles code as it runs), ProcSubset=pid (.NET
# reads /proc/meminfo and the cgroup files) and ProtectProc=invisible (.NET finds systemd by reading
# PID 1 in /proc; hidden, it never says it is ready and the start times out).
# Check with: systemd-analyze security pecklist
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=true
UMask=0027
ReadWritePaths=/var/lib/pecklist

[Install]
WantedBy=multi-user.target
