# Settings for the server, one NAME=value per line (no quotes, no spaces around `=`). Every setting
# has a default; the full list is docs/configuration/reference.md. Secret ones go in the
# `pecklist-secrets` Secret instead (secret.example.yaml).

# Without TZ, apps use the zone of the device they run on, and the server uses UTC.
# TZ=Europe/Berlin

# Snapshots to /data/snapshots: a week of dailies and a month of weeklies.
BACKUP_SCHEDULE=daily
SNAPSHOT_KEEP=7

# Logs as JSON lines, for a cluster's log collector.
LOG_FORMAT=json
