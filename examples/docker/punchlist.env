# An env file for `docker run --env-file punchlist.env` or compose `env_file: punchlist.env`.
# Every line is NAME=value; no quotes, no spaces around `=`. Delete what you do not need: every
# setting has a default. The full list: docs/configuration/reference.md

TZ=Etc/UTC
PUBLIC_URL=https://tasks.example.com

# Accounts
ACCOUNT_DELETE_GRACE_DAYS=7
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Backups (snapshots in /data/snapshots)
BACKUP_SCHEDULE=daily
SNAPSHOT_KEEP=14

# Logs
LOG_LEVEL=information
LOG_FORMAT=text
# LOG_LOKI_URL=http://loki:3100

# Behind a reverse proxy that is not on a private network:
# TRUSTED_PROXIES=203.0.113.7
