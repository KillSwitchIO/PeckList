{
  "name": "pecklist",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hostable, offline-first task and calendar app",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @pecklist/web dev",
    "build": "pnpm --filter @pecklist/web build",
    "preview": "pnpm --filter @pecklist/web preview",
    "test": "pnpm --filter @pecklist/web test",
    "test:coverage": "pnpm --filter @pecklist/web test:coverage",
    "test:browser": "pnpm --filter @pecklist/web test:browser",
    "e2e": "pnpm --filter @pecklist/e2e test",
    "e2e:server": "pnpm --filter @pecklist/e2e test:server",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "changelog": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "build:quick-add": "node scripts/build-quick-add.mjs",
    "check:quick-add": "node scripts/build-quick-add.mjs --check",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck",
    "pre-push": "pnpm test:coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html,mjs}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9.0.0 <14.0.2": "14.0.4",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "serialize-javascript@<7.1.3": "7.1.4",
      "tinypool@<2.1.2": "2.1.2",
      "uuid@<11.1.1": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "git-cliff": "2.14.2",
    "globals": "17.14.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
