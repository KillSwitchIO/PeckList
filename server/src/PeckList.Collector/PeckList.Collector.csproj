<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The telemetry collector (PL-116): takes servers' daily pings into PostgreSQL and serves the
       totals for the project. Deployed on its own, by the project; a Punchlist server never runs it. -->
  <PropertyGroup>
    <AssemblyName>punchlist-collector</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeckList.Core\PeckList.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema.sql" LogicalName="Schema.sql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PeckList.Collector.Tests" />
  </ItemGroup>
</Project>
